# Copiez ce fichier en .env et adaptez le chemin selon votre installation
# cp .env.example .env

# Chemin vers le dataset Nezha complet (optionnel)
# Si non défini ou si .env est absent, tests/mini_data est utilisé par défaut
#
# Pour obtenir les résultats du rapport (fenêtre 08_43 → WARNING/return),
# téléchargez Nezha et pointez ici :
# git clone https://github.com/IntelligentDDS/Nezha.git /tmp/nezha
# mkdir -p ~/nezha_data/{normal,anomalies}
# cp -r /tmp/nezha/construct_data/* ~/nezha_data/normal/
# cp -r /tmp/nezha/rca_data/* ~/nezha_data/anomalies/
DATA_DIR=/chemin/vers/votre/data/nezha
